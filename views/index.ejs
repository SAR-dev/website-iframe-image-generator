<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.tailwindcss.com"></script>
    <title>Document</title>
    <style>
      .custom {
        background-color: "<%= snapshot.bg %>";
        color: "<%= snapshot.color %>";
      }
    </style>
  </head>
  <body>
    <div class="flex min-h-screen w-full relative group">
      <img
        class="rounded-lg w-full object-cover"
        src="<%= snapshot.image  %>"
        alt=""
      />
      <div
        class="absolute top-0 left-0 h-full w-full justify-center items-center hidden group-hover:flex bg-gray-500/75 rounded-lg"
      >
        <button
          type="button"
          style="
            background-color: <%= snapshot.bg %>;
            color: <%= snapshot.color %>;
          "
          class="focus:outline-none focus:ring-4 focus:ring-gray-300 font-medium rounded-lg text-sm px-5 py-2.5 mr-2 mb-2"
        >
          <%= snapshot.text %>
        </button>
    </div>
  </body>
</html>
